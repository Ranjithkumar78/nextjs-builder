# ------------------------------------------------------------------
# Theme storage API
# ------------------------------------------------------------------

# Base URL of the theme-builder-api Laravel backend (../theme-builder-api, no trailing slash). The builder calls
# <base>/custom-themes and <base>/custom-theme-assets through its own /api/theme-builder proxy.
THEME_API_BASE_URL=http://127.0.0.1:8001/api/v2/web

# Event data API (theme-builder-api), used by the Speakers, Sponsors, Tickets and Sessions components
# (sent with the theme's event ID in the X-STUTZEE-EVENT-ID header).
THEME_MICROSITE_API_BASE_URL=http://127.0.0.1:8001/api/v2/microsite

# Request timeout in milliseconds.
THEME_API_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Client-side settings (exposed to the browser)
# ------------------------------------------------------------------

# Autosave delay in milliseconds after the last edit.
NEXT_PUBLIC_AUTOSAVE_DELAY_MS=1500
