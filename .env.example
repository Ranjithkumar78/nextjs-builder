# ------------------------------------------------------------------
# Theme builder API (Laravel, ../theme-builder-api-v2)
# ------------------------------------------------------------------

# Base URL of the Laravel theme builder API, no trailing slash. The builder reaches it only through its own
# /api/theme-builder proxy (custom-themes, custom-themes/{id}/pages/{id}, custom-theme-assets, event-data/{source}).
# Speakers, sponsors, tickets and sessions are fetched and cached by the Laravel API
# (set THEME_MICROSITE_API_BASE_URL in the Laravel .env).
THEME_API_BASE_URL=http://127.0.0.1:8001/api/v1/web

# Request timeout in milliseconds (waiting for the API to answer).
THEME_API_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Client-side settings (exposed to the browser)
# ------------------------------------------------------------------

# Autosave delay in milliseconds after the last edit.
NEXT_PUBLIC_AUTOSAVE_DELAY_MS=1500
